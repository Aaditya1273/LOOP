# ANZEN service configuration. Nothing falls back silently: a missing value stops the service.
# Contract addresses come from contracts/deployments/<ANZEN_CHAIN_ID>.json (written by script/Deploy.s.sol).

# Monad testnet
ANZEN_CHAIN_ID=10143
ANZEN_RPC_URL=https://testnet-rpc.monad.xyz
# Pays gas for relayed actions; fund it with testnet MON. Also owns TestDollar (mints faucet tUSD).
ANZEN_RELAYER_KEY=
# Signs venue check-in codes. Its address goes into every event's terms. Keep it separate from the relayer.
ANZEN_ISSUER_KEY=
ANZEN_DB=anzen.db
# 100 tUSD (6 decimals) per new account
ANZEN_FAUCET_AMOUNT=100000000
