# Source this to put the user-local toolchains on PATH (no system changes).
#   . scripts/toolchain.env
export JAVA_HOME="$(ls -d "$HOME"/.local/share/jdk/jdk-17* 2>/dev/null | head -1)"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export PATH="$HOME/.foundry/bin:$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
